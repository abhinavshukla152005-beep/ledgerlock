# Public address Caddy listens on. Use "<vm-ip>.sslip.io" for automatic HTTPS,
# or ":80" to serve plain HTTP while testing.
SITE_ADDRESS=:80

# Host directory shared by the orchestrator and the Docker daemon.
# It must resolve to the same absolute path inside and outside the api container.
SANDBOX_DIR=/srv/ledgerlock/sandbox

# Vultr Serverless Inference. Without a key the app still runs and writes a
# deterministic template memo; prose policies fall back to the YAML defaults.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=llama-3.3-70b-instruct-fp8
